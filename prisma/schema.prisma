// Sansol Mob Platform — modelo de dados.
// Valores monetários: Decimal(14,2). Taxas/percentuais: Decimal(9,6) como fração (0.05 = 5%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identidade, organizações e acesso ─────────────────────────

enum OrganizationKind {
  OPERATOR // Sansol Mob (operadora da rede)
  INVESTOR // investidor do modelo compra integral
  PARTNER // parceiro do modelo 50/50
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  kind      OrganizationKind
  document  String? // CNPJ/CPF
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  memberships        Membership[]
  roles              Role[]
  leads              Lead[]            @relation("LeadOwnerOrg")
  pipelineStages     PipelineStage[]
  commercialModels   CommercialModel[]
  sitesOperated      Site[]            @relation("SiteOperator")
  sitesAsPartner     Site[]            @relation("SitePartner")
  auditEvents        AuditEvent[]
  simulations        Simulation[]
  companies          Company[]         @relation("CompanyOwnerOrg")
  convertedFrom      Company[]         @relation("CompanyConvertedOrg")
  tasks              CrmTask[]
  contractsAsPartner Contract[]        @relation("ContractPartner")
  financialEntries   FinancialEntry[]  @relation("EntryPartner")
  proposals          Proposal[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean   @default(false)
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships     Membership[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  assignedLeads   Lead[]               @relation("LeadAssignee")
  activities      LeadActivity[]
  ticketsAssigned Ticket[]             @relation("TicketAssignee")
  tasksAssigned   CrmTask[]            @relation("TaskAssignee")
}

model Role {
  id             String        @id @default(cuid())
  organizationId String? // null = perfil de sistema
  organization   Organization? @relation(fields: [organizationId], references: [id])
  key            String
  name           String
  permissions    String[]
  createdAt      DateTime      @default(now())

  memberships Membership[]

  @@unique([organizationId, key])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  organizationId String // organização ativa na sessão
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  @@index([userId])
}

/// Token de uso único para redefinição de senha. Só o hash é persistido.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String? // administrador que gerou o link (null = solicitação do próprio usuário)
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  data           Json?
  correlationId  String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────── CRM ─────────────────────────

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  name           String
  position       Int
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  /// Probabilidade de ganho usada na previsão de receita (0 a 1). Configurável.
  probability    Decimal      @default(0) @db.Decimal(5, 4)

  leads Lead[]

  @@unique([organizationId, key])
}

enum LeadSource {
  WEBSITE_VIABILITY
  WEBSITE_CONTACT
  WEBSITE_SIMULATOR
  MANUAL
  REFERRAL
  EVENT
}

enum BusinessType {
  FUEL_STATION
  SUPERMARKET
  PARKING
  SHOPPING_CENTER
  COMPANY
  OTHER
}

model Lead {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation("LeadOwnerOrg", fields: [organizationId], references: [id])
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  stageChangedAt    DateTime      @default(now())
  assigneeId        String?
  assignee          User?         @relation("LeadAssignee", fields: [assigneeId], references: [id])
  source            LeadSource
  campaign          String?
  contactName       String
  email             String
  emailNormalized   String
  phone             String?
  phoneNormalized   String?
  companyName       String?
  businessType      BusinessType?
  city              String?
  state             String?
  interestModel     String? // chave do modelo comercial de interesse
  message           String?
  lostReason        String?
  priority          LeadPriority  @default(MEDIUM)
  estimatedValue    Decimal?      @db.Decimal(14, 2)
  expectedCloseDate DateTime?
  nextStep          String?
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id])
  consentAt         DateTime?
  consentPolicyVer  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  activities LeadActivity[]
  tasks      CrmTask[]
  proposals  Proposal[]

  @@index([organizationId, stageId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadActivityKind {
  CREATED
  NOTE
  STAGE_CHANGE
  CALL
  MEETING
  EMAIL
  DUPLICATE_SUBMISSION
  ASSIGNMENT
  TASK
  PROPOSAL
  CONVERSION
  UPDATE
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id])
  kind      LeadActivityKind
  body      String?
  data      Json?
  authorId  String?
  author    User?            @relation(fields: [authorId], references: [id])
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

// ───────────────────────── Modelos comerciais ─────────────────────────

enum FeeBase {
  GROSS_REVENUE // faturamento bruto
  GROSS_NET_OF_PAYMENT_FEES // bruto menos taxa de sistema/gateway
}

enum LossTreatment {
  SHARE_MONTHLY // prejuízo do mês é rateado e aportado pelas partes no mesmo mês
  CARRY_FORWARD // prejuízo acumula e é compensado antes de novas distribuições
}

enum ModelVersionStatus {
  DRAFT
  APPROVED
  RETIRED
}

model CommercialModel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  name           String
  description    String?
  createdAt      DateTime     @default(now())

  versions CommercialModelVersion[]

  @@unique([organizationId, key])
}

model CommercialModelVersion {
  id                         String             @id @default(cuid())
  modelId                    String
  model                      CommercialModel    @relation(fields: [modelId], references: [id])
  version                    Int
  status                     ModelVersionStatus @default(DRAFT)
  effectiveFrom              DateTime?
  effectiveTo                DateTime?
  // Investimento de referência total da unidade e fração aportada pelo investidor/parceiro.
  referenceInvestment        Decimal            @db.Decimal(14, 2)
  partnerCapitalShare        Decimal            @db.Decimal(9, 6)
  // Fração do resultado distribuível destinada ao investidor/parceiro.
  partnerResultShare         Decimal            @db.Decimal(9, 6)
  royaltyRate                Decimal            @db.Decimal(9, 6)
  royaltyBase                FeeBase
  platformFeeRate            Decimal            @db.Decimal(9, 6)
  platformFeeBase            FeeBase
  /// true: a taxa de sistema já inclui o custo do gateway (não informar gateway à parte).
  platformFeeIncludesGateway Boolean            @default(true)
  /// Como prejuízos mensais afetam a partilha (base = resultado operacional, apurado mensalmente).
  lossTreatment              LossTreatment      @default(SHARE_MONTHLY)
  taxRate                    Decimal            @db.Decimal(9, 6)
  taxBase                    FeeBase
  maintenancePolicy          String // texto contratual (ex.: "conforme contrato")
  responsibilities           Json? // { sansol: string[], partner: string[] }
  sourceNote                 String? // origem dos parâmetros
  createdById                String?
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime           @default(now())

  contractVersions ContractVersion[]
  simulations      Simulation[]

  @@unique([modelId, version])
}

model Simulation {
  id             String                  @id @default(cuid())
  parentId       String?
  parent         Simulation?             @relation("SimulationRevisions", fields: [parentId], references: [id])
  revisions      Simulation[]            @relation("SimulationRevisions")
  revision       Int                     @default(1)
  /// Premissas alteradas em relação à revisão anterior: [{ path, before, after }]
  changes        Json?
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  modelVersionId String?
  modelVersion   CommercialModelVersion? @relation(fields: [modelVersionId], references: [id])
  leadId         String?
  name           String
  inputs         Json
  results        Json
  engineVersion  String
  createdById    String?
  createdAt      DateTime                @default(now())

  @@index([organizationId, createdAt])
}

// ───────────────────────── Unidades (base para isolamento de parceiros) ─────────────────────────

enum SiteStatus {
  PROSPECT
  IMPLEMENTATION
  OPERATING
  SUSPENDED
}

model Site {
  id                    String        @id @default(cuid())
  operatorId            String
  operator              Organization  @relation("SiteOperator", fields: [operatorId], references: [id])
  partnerOrganizationId String?
  partnerOrganization   Organization? @relation("SitePartner", fields: [partnerOrganizationId], references: [id])
  name                  String
  city                  String?
  state                 String?
  status                SiteStatus    @default(PROSPECT)
  isDemo                Boolean       @default(false)
  address               String?
  latitude              Decimal?      @db.Decimal(9, 6)
  longitude             Decimal?      @db.Decimal(9, 6)
  openingHours          String?
  isPublic              Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  stations         ChargingStation[]
  contracts        ContractSite[]
  financialEntries FinancialEntry[]
  tickets          Ticket[]
  tariffs          Tariff[]

  @@index([operatorId])
  @@index([partnerOrganizationId])
}

// ───────────────────────── CRM: empresas, contatos, tarefas, propostas ─────────────────────────

model Company {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation("CompanyOwnerOrg", fields: [organizationId], references: [id])
  name                    String
  nameNormalized          String
  document                String? // CNPJ/CPF somente dígitos
  businessType            BusinessType?
  city                    String?
  state                   String?
  convertedOrganizationId String?
  convertedOrganization   Organization? @relation("CompanyConvertedOrg", fields: [convertedOrganizationId], references: [id])
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  contacts Contact[]
  leads    Lead[]

  @@unique([organizationId, document])
  @@index([organizationId, nameNormalized])
}

model Contact {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  email           String?
  emailNormalized String?
  phone           String?
  role            String?
  createdAt       DateTime @default(now())

  @@unique([companyId, emailNormalized])
}

model CrmTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  title          String
  dueAt          DateTime
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, completedAt, dueAt])
  @@index([leadId])
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id])
  number         String
  title          String
  status         ProposalStatus @default(DRAFT)
  sentAt         DateTime?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  versions ProposalVersion[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Versões imutáveis: editar uma proposta cria nova versão.
model ProposalVersion {
  id             String   @id @default(cuid())
  proposalId     String
  proposal       Proposal @relation(fields: [proposalId], references: [id])
  version        Int
  items          Json // [{ description, quantity, unitPrice, total }]
  total          Decimal  @db.Decimal(14, 2)
  validUntil     DateTime
  conditions     String
  modelVersionId String?
  simulationId   String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([proposalId, version])
}

// ───────────────────────── Estações, carregadores e OCPP ─────────────────────────

/// Ambiente do equipamento. Dados de SIMULATED/TEST nunca entram em indicadores de produção.
enum StationEnvironment {
  PRODUCTION
  TEST
  SIMULATED
}

enum ChargingProtocol {
  OCPP16J
  OCPP201 // cadastrável; adaptador NÃO implementado
  NONE
}

enum ConnectionState {
  NEVER_CONNECTED
  CONNECTED
  DISCONNECTED
}

model ChargingStation {
  id                String             @id @default(cuid())
  operatorId        String
  siteId            String
  site              Site               @relation(fields: [siteId], references: [id])
  /// Identidade OCPP (chargeBoxIdentity) — usada na URL do WebSocket.
  ocppIdentity      String             @unique
  /// Hash da senha HTTP Basic do carregador (OCPP Security Profile 1). Só o hash é guardado.
  authSecretHash    String?
  protocol          ChargingProtocol   @default(OCPP16J)
  environment       StationEnvironment @default(PRODUCTION)
  vendor            String?
  model             String?
  serialNumber      String?
  firmwareVersion   String?
  heartbeatInterval Int                @default(300)
  connectionState   ConnectionState    @default(NEVER_CONNECTED)
  lastSeenAt        DateTime?
  lastBootAt        DateTime?
  clockSkewMs       Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  connectors       Connector[]
  sessions         ChargingSession[]
  messages         OcppMessage[]
  tickets          Ticket[]
  workOrders       WorkOrder[]
  maintenancePlans MaintenancePlan[]
  alerts           Alert[]
  commands         RemoteCommand[]

  @@index([operatorId])
  @@index([siteId])
}

enum ConnectorType {
  CCS2
  TYPE2
  CHADEMO
  GBT
  OTHER
}

/// Status OCPP 1.6 + UNKNOWN (sem evidência). Ausência de comunicação NUNCA vira AVAILABLE.
enum ConnectorStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED_EVSE
  SUSPENDED_EV
  FINISHING
  RESERVED
  UNAVAILABLE
  FAULTED
  UNKNOWN
}

model Connector {
  id               String          @id @default(cuid())
  stationId        String
  station          ChargingStation @relation(fields: [stationId], references: [id])
  connectorId      Int
  type             ConnectorType   @default(CCS2)
  maxPowerKw       Decimal         @db.Decimal(8, 2)
  status           ConnectorStatus @default(UNKNOWN)
  errorCode        String?
  /// Horário informado pelo carregador do último status aplicado (ordenação de eventos).
  statusAt         DateTime?
  statusReceivedAt DateTime?

  statusEvents ConnectorStatusEvent[]

  @@unique([stationId, connectorId])
}

model ConnectorStatusEvent {
  id          String          @id @default(cuid())
  connectorPk String
  connector   Connector       @relation(fields: [connectorPk], references: [id])
  status      ConnectorStatus
  errorCode   String?
  chargerTime DateTime?
  receivedAt  DateTime        @default(now())
  /// false quando chegou fora de ordem (mais antigo que o status atual): fica no histórico, não altera o atual.
  applied     Boolean

  @@index([connectorPk, receivedAt])
}

model Tariff {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  pricePerKwh Decimal  @db.Decimal(10, 4)
  pricePerMin Decimal  @default(0) @db.Decimal(10, 4)
  validFrom   DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([siteId, validFrom])
}

enum OcppDirection {
  IN
  OUT
}

/// Log de mensagens OCPP para correlação e idempotência (sem segredos: payloads OCPP 1.6 core não contêm senhas).
model OcppMessage {
  id          String          @id @default(cuid())
  stationId   String
  station     ChargingStation @relation(fields: [stationId], references: [id])
  direction   OcppDirection
  messageId   String
  action      String?
  payload     Json
  response    Json?
  chargerTime DateTime?
  receivedAt  DateTime        @default(now())
  error       String?

  @@unique([stationId, direction, messageId])
  @@index([stationId, receivedAt])
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  /// Sem comunicação com o carregador durante a sessão: valores parciais, aguardando StopTransaction.
  COMMUNICATION_LOST
}

model ChargingSession {
  id                String             @id @default(cuid())
  stationId         String
  station           ChargingStation    @relation(fields: [stationId], references: [id])
  connectorId       Int
  transactionId     Int
  idTag             String
  environment       StationEnvironment
  meterStartWh      Int
  meterStopWh       Int?
  lastMeterWh       Int?
  startedAt         DateTime
  stoppedAt         DateTime?
  stopReason        String?
  status            SessionStatus      @default(ACTIVE)
  driverId          String?
  driver            Driver?            @relation(fields: [driverId], references: [id])
  /// Tarifa vigente no início (snapshot): o custo final não muda se a tarifa mudar depois.
  tariffPricePerKwh Decimal?           @db.Decimal(10, 4)
  tariffPricePerMin Decimal?           @db.Decimal(10, 4)
  /// Valor apurado no encerramento (energia × tarifa + minutos × tarifa/min). Não significa pago.
  amount            Decimal?           @db.Decimal(14, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  measurements  SessionMeasurement[]
  chargeRequest ChargeRequest?
  payments      Payment[]
  rating        SessionRating?

  @@unique([stationId, transactionId])
  @@unique([stationId, connectorId, startedAt, idTag])
  @@index([stationId, status])
}

model SessionMeasurement {
  id        String          @id @default(cuid())
  sessionId String
  session   ChargingSession @relation(fields: [sessionId], references: [id])
  timestamp DateTime
  energyWh  Int?
  powerW    Int?

  @@unique([sessionId, timestamp])
}

enum RemoteCommandType {
  RESET
  REMOTE_START
  REMOTE_STOP
  UNLOCK_CONNECTOR
  CHANGE_AVAILABILITY
}

enum RemoteCommandStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  TIMEOUT
  FAILED
  BLOCKED
}

model RemoteCommand {
  id            String              @id @default(cuid())
  stationId     String
  station       ChargingStation     @relation(fields: [stationId], references: [id])
  type          RemoteCommandType
  payload       Json
  status        RemoteCommandStatus @default(PENDING)
  reason        String?
  ocppMessageId String?             @unique
  response      Json?
  requestedById String
  createdAt     DateTime            @default(now())
  sentAt        DateTime?
  completedAt   DateTime?

  @@index([stationId, status])
}

// ───────────────────────── Motoristas ─────────────────────────

/// Conta de motorista: autenticação SEPARADA da equipe (tabela, cookie e sessões próprios).
model Driver {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  consentAt    DateTime
  consentVer   String
  /// CPF/CNPJ cifrado (AES-256-GCM, DATA_ENCRYPTION_KEY). Exigido pelo Asaas para cadastrar o pagador.
  documentEnc  String?
  /// Últimos dígitos, só para exibição mascarada.
  documentHint String?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())

  gatewayCustomers GatewayCustomer[]
  sessions         DriverSession[]
  vehicles         Vehicle[]
  idTags           DriverIdTag[]
  chargeRequests   ChargeRequest[]
  chargingSessions ChargingSession[]
  payments         Payment[]
  supportRequests  SupportRequest[]
}

model DriverSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([driverId])
}

model Vehicle {
  id             String          @id @default(cuid())
  driverId       String
  driver         Driver          @relation(fields: [driverId], references: [id])
  label          String
  connectorTypes ConnectorType[]
  batteryKwh     Decimal?        @db.Decimal(6, 1)
  createdAt      DateTime        @default(now())
}

/// Identificador OCPP (idTag) do motorista. Usado na autorização do carregador.
model DriverIdTag {
  id        String    @id @default(cuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  idTag     String    @unique
  kind      String    @default("APP")
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

enum ChargeRequestStatus {
  AWAITING_PAYMENT
  START_REQUESTED
  STARTED
  FAILED
  CANCELLED
  /// Pix não pago dentro da janela: cobrança removida no gateway.
  EXPIRED
}

/// Pedido de recarga do motorista: liga pagamento → comando remoto → sessão OCPP.
model ChargeRequest {
  id          String              @id @default(cuid())
  driverId    String
  driver      Driver              @relation(fields: [driverId], references: [id])
  stationId   String
  connectorId Int
  idTag       String
  /// Demonstração: estação SIMULATED, sem cobrança.
  demo        Boolean
  status      ChargeRequestStatus
  failure     String?
  commandId   String?
  sessionId   String?             @unique
  session     ChargingSession?    @relation(fields: [sessionId], references: [id])
  paymentId   String?             @unique
  payment     Payment?            @relation(fields: [paymentId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([driverId, createdAt])
  @@index([stationId, connectorId, status])
}

model SessionRating {
  id        String          @id @default(cuid())
  sessionId String          @unique
  session   ChargingSession @relation(fields: [sessionId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime        @default(now())
}

model SupportRequest {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  sessionId String?
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

// ───────────────────────── Pagamentos ─────────────────────────

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
  DISPUTED
}

enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

model Payment {
  id                 String             @id @default(cuid())
  driverId           String
  driver             Driver             @relation(fields: [driverId], references: [id])
  sessionId          String?
  session            ChargingSession?   @relation(fields: [sessionId], references: [id])
  provider           String
  environment        PaymentEnvironment
  providerRef        String
  status             PaymentStatus
  currency           String             @default("BRL")
  amountAuthorized   Decimal            @default(0) @db.Decimal(14, 2)
  amountCaptured     Decimal            @default(0) @db.Decimal(14, 2)
  amountRefunded     Decimal            @default(0) @db.Decimal(14, 2)
  /// Operadora dona da cobrança (isolamento multiempresa direto).
  operatorId         String?
  /// PREAUTH (reserva + captura: sandbox/cartão) ou PIX (pré-pago).
  method             String             @default("PREAUTH")
  /// Status bruto do gateway (ex.: RECEIVED, CONFIRMED, REFUND_IN_PROGRESS).
  remoteStatus       String?
  /// Valor líquido informado pelo gateway após a tarifa; tarifa = valor − líquido.
  netValue           Decimal?           @db.Decimal(14, 2)
  feeAmount          Decimal?           @db.Decimal(14, 2)
  /// Chave idempotente enviada ao gateway (externalReference).
  externalReference  String?            @unique
  pixPayload         String?
  pixExpiresAt       DateTime?
  invoiceUrl         String?
  splitPolicyId      String?
  splitPolicyVersion Int?
  lastSyncedAt       DateTime?
  /// Situação financeira em análise (pagamento sem recarga, consumo acima do pré-pago etc.).
  reviewReason       String?
  reviewOpenedAt     DateTime?
  reviewResolvedAt   DateTime?
  reviewResolvedById String?
  reviewNote         String?
  failureReason      String?
  /// Conciliação: marcado quando sessão, valor e status do provedor conferem.
  reconciledAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  events        PaymentEvent[]
  refunds       Refund[]
  splits        PaymentSplit[]
  chargeRequest ChargeRequest?

  @@unique([provider, providerRef])
  @@index([status])
  @@index([operatorId, createdAt])
}

/// Evento de webhook. (provedor, eventId) único → reentrega não reprocessa.
model PaymentEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  type           String
  paymentId      String?
  payment        Payment?  @relation(fields: [paymentId], references: [id])
  signatureValid Boolean
  payload        Json
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  outcome        String?
  attempts       Int       @default(0)

  @@unique([provider, eventId])
}

enum RefundStatus {
  REQUESTED
  SUCCEEDED
  FAILED
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id])
  amount        Decimal      @db.Decimal(14, 2)
  status        RefundStatus @default(REQUESTED)
  providerRef   String?
  /// Status do estorno no gateway (PENDING, DONE, CANCELLED…). SUCCEEDED somente com DONE.
  remoteStatus  String?
  reason        String
  requestedById String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
}

/// Estado interno do GATEWAY SANDBOX (simulado). Não é dado financeiro real; existe para testar
/// o adaptador sem credenciais. Nenhum valor daqui representa dinheiro movimentado.
model SandboxGatewayCharge {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(14, 2)
  captured  Decimal  @default(0) @db.Decimal(14, 2)
  refunded  Decimal  @default(0) @db.Decimal(14, 2)
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Anexos (contratos, tickets, ordens de serviço) ─────────────────────────

/// Arquivo anexado. Conteúdo no banco (limite de tamanho e tipos permitidos validados no servidor).
/// O acesso é sempre resolvido pela entidade dona (entityType/entityId), nunca só pelo id do anexo.
model Attachment {
  id               String    @id @default(cuid())
  organizationId   String // operadora dona do registro
  entityType       String // "Contract" | "Ticket" | "WorkOrder" | "FinancialEntry"
  entityId         String
  filename         String
  mimeType         String
  size             Int
  sha256           String
  data             Bytes
  /// Contratos: documento visível no portal do parceiro.
  visibleToPartner Boolean   @default(false)
  uploadedById     String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([entityType, entityId])
}

// ───────────────────────── Contratos ─────────────────────────

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ContractVersionKind {
  ORIGINAL
  AMENDMENT // aditivo
}

enum ContractVersionStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// Base de cálculo de royalty/repasse no fechamento.
enum SettlementBase {
  GROSS_REVENUE // receita bruta
  NET_REVENUE // bruta − tributos − taxa de sistema
  OPERATING_RESULT // receita líquida − custos − royalty
}

model Contract {
  id                    String         @id @default(cuid())
  operatorId            String
  partnerOrganizationId String
  partnerOrganization   Organization   @relation("ContractPartner", fields: [partnerOrganizationId], references: [id])
  number                String
  title                 String
  status                ContractStatus @default(DRAFT)
  statusReason          String?
  createdById           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  versions ContractVersion[]
  sites    ContractSite[]

  @@unique([operatorId, number])
  @@index([partnerOrganizationId])
}

model ContractSite {
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  addedById  String
  addedAt    DateTime @default(now())

  @@id([contractId, siteId])
  @@index([siteId])
}

/// Versão IMUTÁVEL das condições contratuais. Aditivo = nova versão; as anteriores são preservadas.
/// Vigente numa data = versão APROVADA com maior effectiveFrom ≤ data (e data < effectiveTo, se houver).
model ContractVersion {
  id                       String                  @id @default(cuid())
  contractId               String
  contract                 Contract                @relation(fields: [contractId], references: [id])
  version                  Int
  kind                     ContractVersionKind
  status                   ContractVersionStatus   @default(DRAFT)
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  commercialModelVersionId String?
  commercialModelVersion   CommercialModelVersion? @relation(fields: [commercialModelVersionId], references: [id])
  royaltyRate              Decimal                 @db.Decimal(9, 6)
  royaltyBase              SettlementBase
  /// Taxa de sistema sobre a receita bruta (já inclui o custo do gateway).
  platformFeeRate          Decimal                 @db.Decimal(9, 6)
  partnerShareRate         Decimal                 @db.Decimal(9, 6)
  partnerShareBase         SettlementBase
  lossTreatment            LossTreatment           @default(SHARE_MONTHLY)
  paymentTermDays          Int                     @default(10)
  conditions               String
  /// Motivo da versão/aditivo (obrigatório).
  reason                   String
  createdById              String
  createdAt                DateTime                @default(now())
  decidedById              String?
  decidedAt                DateTime?
  decisionNote             String?

  @@unique([contractId, version])
}

// ───────────────────────── Financeiro ─────────────────────────

enum EntryKind {
  RECEIVABLE // a receber / receita
  PAYABLE // a pagar / despesa
}

enum EntryCategory {
  CHARGING_REVENUE // receita de recarga registrada fora do gateway
  OTHER_REVENUE
  ENERGY
  RENT
  MAINTENANCE
  CONNECTIVITY
  INSURANCE
  OTHER_EXPENSE
  PARTNER_SHARE // repasse ao parceiro (gerado no fechamento)
  PARTNER_CONTRIBUTION // aporte do parceiro em prejuízo (gerado no fechamento)
  ADJUSTMENT // ajuste de período fechado
}

enum EntryStatus {
  OPEN // provisionado / em aberto
  PAID // baixado (pago ou recebido) — registro manual, nunca transferência pela plataforma
  CANCELLED
}

enum EntrySource {
  MANUAL
  CLOSING
  ADJUSTMENT
  WORK_ORDER
}

model FinancialEntry {
  id                    String         @id @default(cuid())
  operatorId            String
  kind                  EntryKind
  category              EntryCategory
  status                EntryStatus    @default(OPEN)
  source                EntrySource    @default(MANUAL)
  description           String
  /// Sempre positivo; o sentido vem de `kind`.
  amount                Decimal        @db.Decimal(14, 2)
  /// Competência "AAAA-MM".
  competence            String
  dueDate               DateTime?
  siteId                String?
  site                  Site?          @relation(fields: [siteId], references: [id])
  stationId             String?
  partnerOrganizationId String?
  partnerOrganization   Organization?  @relation("EntryPartner", fields: [partnerOrganizationId], references: [id])
  contractId            String?
  closingId             String?
  closing               PeriodClosing? @relation(fields: [closingId], references: [id])
  /// Ajuste: período fechado ao qual o lançamento se refere.
  adjustsPeriod         String?
  workOrderId           String?        @unique
  paidAt                DateTime?
  paidAmount            Decimal?       @db.Decimal(14, 2)
  paymentNote           String?
  paidById              String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([operatorId, competence])
  @@index([partnerOrganizationId, competence])
  @@index([closingId])
}

/// Tributo configurável (fração sobre a receita bruta), versionado por vigência.
model TaxRule {
  id            String    @id @default(cuid())
  operatorId    String
  name          String
  rate          Decimal   @db.Decimal(9, 6)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())

  @@index([operatorId])
}

enum ClosingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED // dados mudaram entre a prévia e a aprovação
}

/// Fechamento mensal. O resultado aprovado é imutável (snapshot + hash). Índices parciais na
/// migração garantem no máximo um APPROVED e um PENDING_APPROVAL por (operadora, período).
model PeriodClosing {
  id            String        @id @default(cuid())
  operatorId    String
  period        String
  status        ClosingStatus @default(PENDING_APPROVAL)
  result        Json
  resultHash    String
  engineVersion String
  validations   Json
  requestedById String
  requestedAt   DateTime      @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  entries FinancialEntry[]

  @@index([operatorId, period])
}

// ───────────────────────── Suporte, SLA e manutenção ─────────────────────────

enum TicketCategory {
  CHARGER_FAULT
  CONNECTIVITY
  PAYMENT
  DRIVER_SUPPORT
  INSTALLATION
  PREVENTIVE
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketOrigin {
  MANUAL
  DRIVER
  ALERT
  PARTNER
  PREVENTIVE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_THIRD_PARTY // pausa o SLA (motivo obrigatório)
  WAITING_REQUESTER // pausa o SLA (motivo obrigatório)
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketEventKind {
  CREATED
  COMMENT
  STATUS_CHANGE
  ASSIGNMENT
  PRIORITY_CHANGE
  PAUSE
  RESUME
  WORK_ORDER
  ATTACHMENT
  ALERT
}

/// SLA por prioridade (opcionalmente por contrato). O ticket guarda uma cópia na criação:
/// mudar a política não altera prazos de tickets existentes.
model SlaPolicy {
  id                String         @id @default(cuid())
  operatorId        String
  contractId        String?
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int
  businessHoursOnly Boolean        @default(false)
  workStartHour     Int            @default(8)
  workEndHour       Int            @default(18)
  workDays          Int[]          @default([1, 2, 3, 4, 5])
  active            Boolean        @default(true)
  createdById       String?
  createdAt         DateTime       @default(now())

  @@index([operatorId, priority, active])
}

model Ticket {
  id                   String           @id @default(cuid())
  operatorId           String
  number               String
  title                String
  description          String
  category             TicketCategory
  priority             TicketPriority
  origin               TicketOrigin
  status               TicketStatus     @default(OPEN)
  assigneeId           String?
  assignee             User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  siteId               String?
  site                 Site?            @relation(fields: [siteId], references: [id])
  stationId            String?
  station              ChargingStation? @relation(fields: [stationId], references: [id])
  contractId           String?
  supportRequestId     String?          @unique
  createdById          String?
  slaPolicyId          String?
  slaResponseMinutes   Int?
  slaResolutionMinutes Int?
  /// Calendário copiado da política: { businessHoursOnly, workStartHour, workEndHour, workDays }
  slaCalendar          Json?
  firstResponseAt      DateTime?
  pausedSince          DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  events     TicketEvent[]
  workOrders WorkOrder[]
  alert      Alert?

  @@unique([operatorId, number])
  @@index([operatorId, status])
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id])
  kind      TicketEventKind
  body      String?
  data      Json?
  authorId  String?
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
}

enum WorkOrderStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id              String           @id @default(cuid())
  operatorId      String
  number          String
  type            WorkOrderType
  status          WorkOrderStatus  @default(OPEN)
  title           String
  ticketId        String?
  ticket          Ticket?          @relation(fields: [ticketId], references: [id])
  planId          String?
  plan            MaintenancePlan? @relation(fields: [planId], references: [id])
  stationId       String
  station         ChargingStation  @relation(fields: [stationId], references: [id])
  diagnosis       String?
  technicianName  String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  /// [{ item: string, done: boolean }]
  checklist       Json             @default("[]")
  laborCost       Decimal          @default(0) @db.Decimal(14, 2)
  completionNotes String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  parts WorkOrderPart[]

  @@unique([operatorId, number])
  @@index([operatorId, status])
  @@index([planId])
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitCost    Decimal   @db.Decimal(14, 2)
  total       Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
}

enum MaintenanceTrigger {
  TIME // a cada N dias
  ENERGY_KWH // a cada N kWh entregues (telemetria de produção)
  SESSIONS // a cada N sessões (telemetria de produção)
}

model MaintenancePlan {
  id               String             @id @default(cuid())
  operatorId       String
  stationId        String
  station          ChargingStation    @relation(fields: [stationId], references: [id])
  name             String
  trigger          MaintenanceTrigger
  intervalDays     Int?
  intervalKwh      Int?
  intervalSessions Int?
  /// Itens do checklist copiados para cada OS gerada.
  checklist        String[]
  active           Boolean            @default(true)
  createdById      String
  createdAt        DateTime           @default(now())

  workOrders WorkOrder[]
}

// ───────────────────────── Alertas, automações e notificações ─────────────────────────

enum AlertKind {
  STATION_OFFLINE
  REPEATED_FAULTS
  AVAILABILITY_DROP
  SESSION_INTERRUPTED
  PAYMENT_DIVERGENCE
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AlertRule {
  id                   String                @id @default(cuid())
  operatorId           String
  kind                 AlertKind
  name                 String
  enabled              Boolean               @default(true)
  severity             AlertSeverity
  /// Parâmetros por tipo (validados por Zod no servidor).
  params               Json
  /// Limite de frequência: alerta resolvido que reaparece dentro deste prazo é reaberto (sem nova notificação).
  cooldownMinutes      Int                   @default(60)
  escalateAfterMinutes Int?
  createTicket         Boolean               @default(false)
  ticketPriority       TicketPriority        @default(HIGH)
  notifyChannels       NotificationChannel[]
  includeNonProduction Boolean               @default(false)
  updatedById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  alerts Alert[]

  @@unique([operatorId, kind])
}

/// Alerta deduplicado por dedupeKey: índice único parcial (status ≠ RESOLVED) na migração.
model Alert {
  id               String           @id @default(cuid())
  operatorId       String
  ruleId           String
  rule             AlertRule        @relation(fields: [ruleId], references: [id])
  kind             AlertKind
  severity         AlertSeverity
  status           AlertStatus      @default(OPEN)
  dedupeKey        String
  title            String
  detail           String
  stationId        String?
  station          ChargingStation? @relation(fields: [stationId], references: [id])
  /// Ocorrências agregadas (reaparições e confirmações a cada avaliação).
  occurrences      Int              @default(1)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  /// false = exige resolução manual (ex.: sessão interrompida, divergência).
  autoResolve      Boolean          @default(true)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedReason   String?
  escalatedAt      DateTime?
  ticketId         String?          @unique
  ticket           Ticket?          @relation(fields: [ticketId], references: [id])
  createdAt        DateTime         @default(now())

  notifications Notification[]

  @@index([operatorId, status])
  @@index([operatorId, dedupeKey])
}

/// Registro de cada execução de automação (avaliação de alertas, preventiva, notificações).
model AutomationRun {
  id         String    @id @default(cuid())
  operatorId String?
  job        String
  status     String // RUNNING | SUCCEEDED | FAILED
  attempt    Int       @default(1)
  stats      Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED // esgotou as tentativas
  SKIPPED_NOT_CONFIGURED
  SKIPPED_NO_CONSENT
}

/// Consentimento do próprio usuário para receber alertas por canal (opt-in, revogável).
model NotificationRecipient {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  channel        NotificationChannel
  destination    String
  consentAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@unique([userId, organizationId, channel])
}

/// Fila de notificações (outbox). dedupeKey único impede duplicidade e laços de reenvio.
model Notification {
  id              String              @id @default(cuid())
  operatorId      String
  alertId         String?
  alert           Alert?              @relation(fields: [alertId], references: [id])
  channel         NotificationChannel
  recipientUserId String?
  destination     String?
  subject         String
  body            String
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(5)
  nextAttemptAt   DateTime?
  lastError       String?
  sentAt          DateTime?
  dedupeKey       String              @unique
  createdAt       DateTime            @default(now())

  @@index([status, nextAttemptAt])
}

// ───────────────────────── Gateway Asaas: clientes, idempotência, split e habilitação ─────────────────────────

/// Pagador cadastrado no gateway: um por (provedor, ambiente, operadora, motorista); reaproveitado em retries.
model GatewayCustomer {
  id          String             @id @default(cuid())
  provider    String
  environment PaymentEnvironment
  operatorId  String
  driverId    String
  driver      Driver             @relation(fields: [driverId], references: [id])
  remoteId    String
  createdAt   DateTime           @default(now())

  @@unique([provider, environment, operatorId, driverId])
  @@unique([provider, environment, remoteId])
}

enum PaymentOperationStatus {
  STARTED
  SUCCEEDED
  FAILED
  /// Requisição enviada sem resposta (timeout): resultado desconhecido até a verificação.
  UNKNOWN
}

/// Operação financeira idempotente (criar cobrança, estornar, cancelar). key única por operação de negócio.
model PaymentOperation {
  id              String                 @id @default(cuid())
  key             String                 @unique
  kind            String
  provider        String
  environment     PaymentEnvironment
  operatorId      String?
  status          PaymentOperationStatus @default(STARTED)
  chargeRequestId String?
  paymentId       String?
  remoteId        String?
  attempts        Int                    @default(1)
  lastError       String?
  /// Resumos sem dados pessoais nem segredos.
  request         Json?
  response        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, kind])
}

enum RecipientStatus {
  PENDING_VALIDATION
  ACTIVE
  DISABLED
}

/// Recebedor financeiro do split (conta Asaas do parceiro). Cadastro comercial do posto ≠ recebedor.
model PaymentRecipient {
  id             String             @id @default(cuid())
  operatorId     String
  organizationId String
  environment    PaymentEnvironment
  walletId       String
  status         RecipientStatus    @default(PENDING_VALIDATION)
  note           String?
  createdById    String
  validatedById  String?
  validatedAt    DateTime?
  disabledAt     DateTime?
  createdAt      DateTime           @default(now())

  participants SplitParticipant[]

  @@unique([environment, walletId])
  @@index([operatorId, organizationId])
}

enum SplitPolicyStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// Política de split versionada, imutável após decisão (quatro olhos). Percentuais incidem sobre o netValue.
model SplitPolicy {
  id            String            @id @default(cuid())
  operatorId    String
  /// null = padrão da operadora; preenchido = específica da unidade.
  siteId        String?
  version       Int
  status        SplitPolicyStatus @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  /// Tratamento das tarifas aprovado comercialmente (texto).
  feeTreatment  String
  reason        String
  createdById   String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime          @default(now())

  participants SplitParticipant[]

  @@index([operatorId, siteId, status])
}

model SplitParticipant {
  id              String            @id @default(cuid())
  policyId        String
  policy          SplitPolicy       @relation(fields: [policyId], references: [id])
  /// SITE_PARTNER: recebedor ativo do parceiro da unidade; RECIPIENT: recebedor fixo.
  kind            String
  recipientId     String?
  recipient       PaymentRecipient? @relation(fields: [recipientId], references: [id])
  percentualValue Decimal?          @db.Decimal(7, 4)
  fixedValue      Decimal?          @db.Decimal(14, 2)
  description     String?
}

/// Split enviado em uma cobrança (cópia da política aplicada) e seu estado no gateway.
model PaymentSplit {
  id                 String    @id @default(cuid())
  paymentId          String
  payment            Payment   @relation(fields: [paymentId], references: [id])
  operatorId         String
  organizationId     String
  recipientId        String?
  walletId           String
  percentualValue    Decimal?  @db.Decimal(7, 4)
  fixedValue         Decimal?  @db.Decimal(14, 2)
  /// Valor informado pelo gateway (pode mudar até a liquidação).
  totalValue         Decimal?  @db.Decimal(14, 2)
  externalReference  String    @unique
  remoteId           String?
  status             String    @default("PENDING")
  cancellationReason String?
  doneAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([paymentId])
  @@index([organizationId, status])
}

enum ActivationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// Autorização explícita para operar pagamentos REAIS. Decidida por pessoa diferente de quem solicitou.
model GatewayActivation {
  id            String           @id @default(cuid())
  provider      String
  operatorId    String
  status        ActivationStatus @default(PENDING)
  /// Confirmações declaradas (tarifas, split, estorno, monitoramento, suporte) e observações.
  checklist     Json
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  revokedAt     DateTime?
  revokedById   String?
  createdAt     DateTime         @default(now())

  @@index([provider, operatorId, status])
}
