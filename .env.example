# Copie para .env e ajuste. Nunca commite o .env.
DATABASE_URL="postgresql://USER@localhost:5432/sansol_dev"
# Banco usado somente pelos testes de integração (é recriado a cada execução).
TEST_DATABASE_URL="postgresql://USER@localhost:5432/sansol_test"
# Segredo para hash de IP no rate limit (gere com: openssl rand -hex 32)
APP_SECRET="troque-por-um-valor-aleatorio"
# Senha inicial do superadministrador criada pelo seed de desenvolvimento.
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
