# Copie para .env e ajuste. Nunca commite o .env.
DATABASE_URL="postgresql://USER@localhost:5432/sansol_dev"
# Banco usado somente pelos testes de integração (é recriado a cada execução).
TEST_DATABASE_URL="postgresql://USER@localhost:5432/sansol_test"
# Segredo para hash de IP no rate limit (gere com: openssl rand -hex 32)
APP_SECRET="troque-por-um-valor-aleatorio"
# Senha inicial do superadministrador criada pelo seed de desenvolvimento.
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
# Defina 1 somente se a aplicação estiver atrás de um proxy reverso que sobrescreve X-Forwarded-For/X-Real-IP.
TRUST_PROXY="0"
# URL pública usada em links (sitemap, redefinição de senha).
PUBLIC_SITE_URL="http://localhost:3000"
# Servidor OCPP 1.6-J (processo separado: npm run ocpp:server)
OCPP_PORT="9220"
# URL exibida aos técnicos para configurar o carregador (use wss:// em produção, com TLS no proxy)
OCPP_PUBLIC_URL="ws://localhost:9220"
# 1 habilita comandos remotos em equipamentos de PRODUÇÃO (exige também permissão de superadmin). Mantenha 0 fora da operação real.
OCPP_ALLOW_PRODUCTION_COMMANDS="0"
# Pagamentos. "sandbox" = gateway SIMULADO local (sem dinheiro); "asaas" = Asaas (ver bloco abaixo). Vazio = nenhum provedor.
PAYMENT_PROVIDER=""
# Segredo HMAC dos webhooks do sandbox (gere com: openssl rand -hex 32)
PAYMENT_SANDBOX_WEBHOOK_SECRET=""
# Valor da pré-autorização (reserva) por recarga, em R$
PAYMENT_PREAUTH_AMOUNT="100"

# ── Asaas (docs.asaas.com) ── NUNCA commite valores. Produção exige as 3 condições + aprovação na plataforma.
# "sandbox" (api-sandbox.asaas.com) ou "production" (api.asaas.com). Sem valor = Asaas desligado.
ASAAS_ENVIRONMENT=""
# Chave de API da conta SANDBOX (gerada no painel do sandbox do Asaas).
# As chaves do Asaas começam com "$": escreva "\$" no início (ex.: ASAAS_SANDBOX_API_KEY=\$aact_hmlg_...), sem aspas.
# Next.js e os scripts (scripts/load-env.mjs) expandem "$" — sem o escape a chave fica vazia.
ASAAS_SANDBOX_API_KEY=""
# Chave de API de PRODUÇÃO. Só use após a homologação; nunca em testes automatizados.
ASAAS_PRODUCTION_API_KEY=""
# 1 somente depois da homologação aprovada (Etapa E). Mesmo assim, a plataforma exige aprovação registrada por superadmin.
ASAAS_PRODUCTION_ENABLED="0"
# Token do webhook (mínimo 32 caracteres, diferente da chave de API). Cadastre o MESMO valor no webhook do Asaas.
# Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=""
# 1 habilita o split na criação das cobranças (exige política aprovada e recebedores validados).
ASAAS_SPLIT_ENABLED="0"
# walletId da própria conta WeMob (impede cadastrá-la como recebedor do split; o resíduo fica nela).
ASAAS_OWN_WALLET_ID=""
# Identificação enviada no header User-Agent (exigido pelo Asaas para contas novas).
ASAAS_USER_AGENT="WeMob-SansolMob/1.0"
# Tempo máximo por requisição ao Asaas, em ms (2000–60000). Timeout = resultado DESCONHECIDO (verificado pela chave).
ASAAS_TIMEOUT_MS="15000"
# Janela para o motorista pagar o Pix antes de a cobrança ser removida (minutos, 3–60).
PIX_PAYMENT_WINDOW_MINUTES="15"
# Margem de segurança do limite financeiro da sessão (fração da cobertura, 0.02–0.30; padrão 0.10):
# limite = valor pago (ou reservado) × (1 − margem). Atingido → parada remota automática.
SESSION_LIMIT_MARGIN="0.10"

# Chave AES-256-GCM para dados pessoais em repouso (CPF/CNPJ do motorista). 32 bytes em hex (64 caracteres) ou base64.
# Gere com: openssl rand -hex 32. Perder a chave impede ler os documentos já gravados.
DATA_ENCRYPTION_KEY=""

# Primeiro administrador em ambientes novos (npm run setup:first-admin). Remova após o uso.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# OPERATOR_NAME="Sansol Mob"
