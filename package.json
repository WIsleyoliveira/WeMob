{
  "name": "sansol-mob-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --import ./scripts/load-env.mjs prisma/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "ocpp:server": "tsx --import ./scripts/load-env.mjs scripts/ocpp-server.ts",
    "ocpp:simulate": "tsx --import ./scripts/load-env.mjs scripts/ocpp-simulate.ts",
    "dev:users": "tsx --import ./scripts/load-env.mjs scripts/dev-users.ts",
    "setup:first-admin": "tsx scripts/bootstrap-production.ts",
    "asaas:homologar": "tsx --import ./scripts/load-env.mjs scripts/asaas-homologar.ts",
    "asaas:webhook": "tsx --import ./scripts/load-env.mjs scripts/asaas-webhook.ts",
    "e2e:rotas": "tsx --import ./scripts/load-env.mjs scripts/e2e-rotas.ts",
    "db:status": "prisma migrate status",
    "e2e:build": "node scripts/build-dist.mjs .next-e2e",
    "e2e:browser": "tsx --import ./scripts/load-env.mjs scripts/e2e-browser.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.12"
  },
  "prisma": {
    "seed": "tsx --import ./scripts/load-env.mjs prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@prisma/config": {
      "effect": "3.22.4",
      "deepmerge-ts": "8.0.2"
    }
  }
}
